          ]
        },
        {
          "layout": "figure",
          "reveal": "lines",
          "hold": 4500,
          "figure": {
            "src": "../img/13_3.jpg",
            "alt": "原文配图"
          }
        },
        {
          "layout": "read",
          "reveal": "lines",
          "hold": 5000,
          "blocks": [
            {
              "type": "p",
              "text": "我们的需要、价值观和欲望，会随着时间不断演化。",
              "pids": [
                "p47"
              ]
            },
            {
              "type": "p",
              "text": "首先，人需要安全和舒适。",
              "pids": [
                "p48"
              ]
            },
            {
              "type": "p",
              "text": "其次，他们需要归属和地位。",
              "pids": [
                "p49"
              ]
            },
            {
              "type": "p",
              "text": "再次，他们渴望更深层的意义、使命和体验。",
              "pids": [
                "p50"
              ]
            }
          ],
          "pids": [
            "p47",
