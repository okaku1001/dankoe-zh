            {
              "type": "p",
              "text": "尼维：嗨，你正在收听 Naval Podcast。我是他的固定搭档，尼维。",
              "pids": [
                "p1"
              ]
            },
            {
              "type": "p",
              "text": "人这一生必须掌握的技能只有两项：怎么建造，怎么销售。今天我们要谈销售这一块。",
              "pids": [
                "p2"
              ]
            }
          ],
          "pids": [
            "p1",
            "p2",
            "p1",
            "p2"
          ]
